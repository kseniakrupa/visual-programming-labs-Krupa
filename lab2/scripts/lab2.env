# Переменные окружения для контейнера Node-RED (лабораторная работа №2).
# Передаются при запуске: docker run --env-file lab2.env ...
# Читаются в потоке 2.12 через env.get("LAB2_STUDENT") и т. д.
#
# Файл в UTF-8 без BOM: docker читает его как байты, поэтому кириллица
# доходит до контейнера без искажений (в отличие от -e с русским текстом
# в командной строке Windows, где значение проходит через ANSI-кодировку).

LAB2_STUDENT=Крупа Ксения
LAB2_GROUP=ИИ-241
LAB2_LAB=2
