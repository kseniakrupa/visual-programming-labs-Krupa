                "f10_fn_time"
            ]
        ]
    },
    {
        "id": "f10_fn_time",
        "type": "function",
        "z": "tab10",
        "name": "function: текущее время",
        "func": "// Достаём chatId до того, как перезапишем payload.\nconst chatId = msg.payload.chatId || (msg.payload.chat && msg.payload.chat.id);\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Сейчас на сервере Node-RED: \" + new Date().toLocaleString(\"ru-RU\")\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 320,
        "wires": [
            [
                "f10_sender"
            ]
        ]
    },
    {
        "id": "f10_receiver",
        "type": "telegram receiver",
        "z": "tab10",
        "name": "receiver: все сообщения",
        "bot": "f10_bot",
        "saveDataDir": "",
        "filterCommands": false,
        "x": 200,
        "y": 440,
        "wires": [
            [
                "f10_fn_echo",
                "f10_dbg_raw"
            ]
        ]
    },
    {
        "id": "f10_fn_echo",
        "type": "function",
        "z": "tab10",
        "name": "function: echo (кроме команд)",
        "func": "// Достаём chatId до того, как перезапишем payload.\nconst chatId = msg.payload.chatId || (msg.payload.chat && msg.payload.chat.id);\nconst text = String(msg.payload.content || \"\");\n\n// Команды уже обработаны нодами telegram command — их не дублируем.\nif (text.trim().startsWith(\"/\")) {\n    return null;\n}\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Эхо: \" + text + \"\\n(сообщение получено в \" + new Date().toLocaleTimeString(\"ru-RU\") + \")\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 420,
        "wires": [
            [
                "f10_sender"
            ]
        ]
    },
