    {
        "id": "f10_fn_start",
        "type": "function",
        "z": "tab10",
        "name": "function: приветствие",
        "func": "// Достаём chatId до того, как перезапишем payload.\nconst chatId = msg.payload.chatId || (msg.payload.chat && msg.payload.chat.id);\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Привет! Я бот tvl_lab2_krupa_bot.\" + \"\\n\" +\n    \"Студент: Крупа Ксения, лабораторная №2 (Node-RED).\" + \"\\n\" +\n    \"Доступные команды: /start, /help, /time.\" + \"\\n\" +\n    \"На любое другое сообщение отвечу эхом.\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 160,
        "wires": [
            [
                "f10_sender"
            ]
        ]
    },
