    {
        "id": "f10_fn_help",
        "type": "function",
        "z": "tab10",
        "name": "function: справка",
        "func": "// Достаём chatId до того, как перезапишем payload.\nconst chatId = msg.payload.chatId || (msg.payload.chat && msg.payload.chat.id);\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Команды бота:\\n/start — приветствие\\n/help — эта справка\\n/time — текущее время сервера\\n\\nЛюбое другое сообщение — echo-ответ.\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 240,
        "wires": [
            [
                "f10_sender"
            ]
        ]
    },
