        "id": "f10_cmd_time",
        "type": "telegram command",
        "z": "tab10",
        "name": "/time",
        "bot": "f10_bot",
        "command": "/time",
        "register": true,
        "language": "",
        "scope": "default",
        "description": "Текущее время сервера",
        "x": 180,
        "y": 340,
        "wires": [
