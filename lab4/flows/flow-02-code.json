        "jsCode": "let counter = 0;\nconst tags = [];\nconst result = { user: \"Krupa\", group: \"II-241\", items: [] };\n\nfor (let i = 1; i <= 5; i++) {\n  if (i % 2 === 0) {\n    tags.push(`even-${i}`);\n  } else {\n    tags.push(`odd-${i}`);\n  }\n  counter++;\n  result.items.push({ index: i, tag: tags[tags.length - 1] });\n}\n\nconst message = counter > 3 ? \"many\" : \"few\";\n\nreturn [{\n  json: {\n    payload: `Krupa: processed ${counter} items (${message})`,\n    tags,\n    result\n  }\n}];"
      },
